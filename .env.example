# Copy this file to .env and fill in what you need.
# Everything has a safe default, so the app runs out of the box in MOCK mode
# (no OpenAI key needed) - just with heuristic, not GPT-4o-powered, AI behavior.

# --- OpenAI (leave blank for MOCK mode) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
WHISPER_MODEL=whisper-1

# --- MySQL ---
DB_NAME=adaptiq
DB_PASSWORD=root

# --- Backend ---
JWT_SECRET=adaptiq-dev-secret-change-me-adaptiq-dev-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (baked in at build time) ---
VITE_API_BASE_URL=http://localhost:8080/api
